# ============================================
# AttendAI Backend — Environment Variables Template
# Copy this file to .env and fill in your local values.
# DO NOT COMMIT THE REAL .env FILE TO GITHUB!
# ============================================

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_database_password
DB_NAME=attendance_system

# --- Flask Core ---
SECRET_KEY=generate_a_random_secret_key_here

# --- Recognition Tunables ---
RECOGNITION_THRESHOLD=0.35
DETECTION_THRESHOLD=0.60
LIVENESS_THRESHOLD=0.70
MIN_FACE_SIZE=80
ATTENDANCE_COOLDOWN_MIN=55
RECOGNITION_FPS=8
MAX_STREAM_THREADS=10

# --- Scheduler ---
SESSION_AUTO_OPEN_TIME=08:00

# --- InsightFace Model ---
INSIGHTFACE_MODEL=buffalo_l

# --- Continue Portal API Integration (Plug-and-Play) ---
CONTINUE_API_BASE_URL=https://college.continue.in/api/v1
CONTINUE_API_KEY=YOUR_CONTINUE_API_KEY_HERE
CONTINUE_AUTH_TYPE=bearer
CONTINUE_SYNC_ENABLED=false
CONTINUE_SYNC_MODE=realtime
CONTINUE_BATCH_INTERVAL=60
CONTINUE_MAX_RETRIES=5
CONTINUE_RETRY_BACKOFF=30
CONTINUE_API_TIMEOUT=10

# Parameter Equalizer Field Names
CONTINUE_STUDENT_ID_FIELD=usn
CONTINUE_STUDENT_FIELD_NAME=roll_no
CONTINUE_SUBJECT_FIELD=subject_code
